# FinPulse API Keys (At least one is required)
# ----------------------------------------------

# Option 1: Google Gemini (Primary logic)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: Groq / Llama 3.3 (Recommended fallback - High rate limits)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# If both keys are absent or rate-limited, the system falls back
# to curated offline responses for demo stability.